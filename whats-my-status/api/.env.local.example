# LocalStack configuration for local development
# Copy to .env.local: cp .env.local.example .env.local

# Point the AWS SDK at LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Table names (auto-default to whats-my-status-local-* when AWS_ENDPOINT_URL is set)
# PRODUCTS_TABLE=whats-my-status-local-products
# INCIDENTS_TABLE=whats-my-status-local-incidents
# INCIDENT_UPDATES_TABLE=whats-my-status-local-incident-updates
# INCIDENT_PRODUCTS_TABLE=whats-my-status-local-incident-products
# ANNOUNCEMENTS_TABLE=whats-my-status-local-announcements
# SETTINGS_TABLE=whats-my-status-local-settings

# Auth
JWT_SECRET=local-dev-secret-at-least-32-characters-long
ADMIN_PASSWORD=changeme

# Dev server
PORT=3001
CORS_ORIGIN=http://localhost:5173
